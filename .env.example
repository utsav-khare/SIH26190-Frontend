# ============================================================
# Digilegal Vault — Environment Configuration
# Copy this file to .env and update values for your environment.
# All variables MUST be prefixed with VITE_ to be exposed to the client.
# ============================================================

# Backend API base URL (leave as /api if using a Vite dev proxy)
VITE_API_URL=/api

# Set to "true" to force mock data even when an API is reachable
VITE_USE_MOCK=true

# Application display name (optional override)
VITE_APP_NAME=Digilegal Vault
